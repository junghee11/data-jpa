# --- Datasource (dev) ---
DB_URL=jdbc:postgresql://localhost:5432/dev_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Datasource (prod) ---
DB_PROD_URL=jdbc:postgresql://your-prod-host:5432/prod_db
DB_PROD_USERNAME=prod_user
DB_PROD_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- JWT ---
JWT_SECRET=please-change-me-to-a-32+char-random-string
JWT_VALIDITY_MS=3600000

# --- AWS Credentials (S3, SQS 공용) ---
AWS_ACCESS_KEY=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket-name

# --- AWS SQS Queue Names ---
AWS_SQS_QUEUE_NOTIFICATIONS=notification-queue
AWS_SQS_QUEUE_CHAT_MESSAGES=chat-messages-queue
AWS_SQS_QUEUE_CHAT_EVENTS=chat-events-queue

# --- Kakao Pay ---
KAKAO_PAY_CID=TC0ONETIME
KAKAO_PAY_CID_SECRET=change-me

# --- Ncloud SENS (SMS) ---
NCLOUD_SMS_ACCESS_KEY=change-me
NCLOUD_SMS_SECRET_KEY=change-me
NCLOUD_SMS_SERVICE_ID=change-me

# --- CoolSMS ---
COOL_SMS_PHONE_FROM=01000000000
COOL_SMS_API_KEY=change-me
COOL_SMS_API_SECRET=change-me
